DATABASE_URL=postgresql://eunsik@localhost:5432/mobicom
# If your local PostgreSQL role is different, replace eunsik with your role.
# Set to true only when your managed PostgreSQL requires SSL.
POSTGRES_SSL=false

# Huly self-host (Phase 0 auth bridge)
# The @hcengineering/* npm packages' version must match the huly-selfhost
# HULY_VERSION Docker tag exactly (huly_v7.conf on the server) — a mismatch makes
# the transactor silently reject every WebSocket connection ("Model version
# mismatch" in its logs, client sees a bare connection timeout).
HULY_URL=https://huly.example.org
HULY_ACCOUNTS_URL=https://huly.example.org/_accounts
HULY_WORKSPACE_URL=mobicom
HULY_ADMIN_EMAIL=admin@example.org
HULY_ADMIN_PASSWORD=change-me
# 32-byte key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MOBION_HULY_ENCRYPTION_KEY=
